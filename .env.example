# Optional. Leave both empty and the app works on one phone only.
# Both values are public by design (they ship inside the APK); row-level security
# in supabase/schema.sql is what protects the data. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (optional). The Web OAuth client ID from Google Cloud; public by design.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
